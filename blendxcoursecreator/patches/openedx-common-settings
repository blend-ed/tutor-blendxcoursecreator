PORTKEY_EMBEDDING_PROVIDER="{{ BLENDXCOURSECREATOR_PORTKEY_EMBEDDING_PROVIDER }}"
{% endif %}

{% if not BLENDXCOURSECREATOR_ENTERPRISE_PLAN %}
# Blend-ed Cloud AI Course Creator API Key
BLENDX_AICC_KEY="{{ BLENDXCOURSECREATOR_BLENDX_AICC_KEY }}"
BLENDX_AICC_APP_URL="{{ BLENDXCOURSECREATOR_BLENDX_AICC_APP_URL }}"
{% endif %}

{% if BLENDXCOURSECREATOR_ENABLE_VIDEO_COMPONENT %}
TAVILY_API_KEY="{{ BLENDXCOURSECREATOR_TAVILY_API_KEY }}"
{% if BLENDXCOURSECREATOR_ENABLE_SYNTHESIA %}
SYNTHESIA_API_KEY="{{ BLENDXCOURSECREATOR_SYNTHESIA_API_KEY }}"
SYNTHESIA_AVATAR_ID="{{ BLENDXCOURSECREATOR_SYNTHESIA_AVATAR_ID }}"
