{% if BLENDXCOURSECREATOR_ENABLE_PORTKEY and BLENDXCOURSECREATOR_ENTERPRISE_PLAN %}
# Portkey Configuration
PORTKEY_API_KEY="{{ BLENDXCOURSECREATOR_PORTKEY_API_KEY }}"
PORTKEY_EMBEDDING_MODEL="{{ BLENDXCOURSECREATOR_PORTKEY_EMBEDDING_MODEL }}"
